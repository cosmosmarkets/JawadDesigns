# Jawad Design — environment template. Copy to .env.local and fill in.
# .env.local is gitignored; this file is the committed template.

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
RESEND_API_KEY=

# /contact order routing (server-only, used by app/api/contact/route.ts).
# Optional — sensible defaults apply if unset. CONTACT_FROM must be a
# Resend-verified sender. Without RESEND_API_KEY the route logs + degrades
# to a success so the funnel still works locally.
CONTACT_TO=
CONTACT_FROM=
